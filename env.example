# E2E Test Configuration
# Copy this file to .env at the repository root; docker-compose loads it automatically.

# ==============================================================================
# TEST CONTAINER BUILD CONFIGURATION
# ==============================================================================
# Leave the host settings blank — the justfile recipes populate them.
HOST_UID=
HOST_GID=

# Path to the vended E2E Dockerfile — populated by the justfile from
# pytest-jupyter-deploy. Leave blank.
E2E_DOCKERFILE=

# AWS region used by full-deployment E2E tests. The justfile resolves this from
# `aws configure get region` when left blank. Config-only tests do not need it.
AWS_REGION=
