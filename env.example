# E2E Test Configuration
# Copy this file to .env at the repository root; docker-compose loads it automatically.

# ==============================================================================
# TEST CONTAINER BUILD CONFIGURATION
# ==============================================================================
# Leave the host settings blank — the justfile recipes populate them.
HOST_UID=
HOST_GID=

# Path to the vended E2E Dockerfile — populated by the justfile from
# pytest-jupyter-deploy. Leave blank.
E2E_DOCKERFILE=

# AWS region used by full-deployment E2E tests. The justfile resolves this from
# `aws configure get region` when left blank. Config-only tests do not need it.
AWS_REGION=

# SageMaker JumpStart public model-cache bucket the weight-import / serving E2E tests
# read weights from. The name embeds the region (jumpstart-cache-prod-<region>), so it is
# NOT derived in-code — set it to the bucket matching your AWS_REGION. Default: us-west-2.
JUMPSTART_PUBLIC_BUCKET_NAME=jumpstart-cache-prod-us-west-2

# EKS admin roles — IAM role names granted EKS cluster admin access (base.yaml
# interpolates this into admin_role_names). The deploying caller is auto-merged by the
# template; list here the extra roles a human uses to operate the cluster.
# Add a DeployRole to work around permission boundaries locally (e.g. an Isengard
# session policy that denies iam:DeleteRole, which blocks `jd down`).
JD_E2E_VAR_ADMIN_ROLE_NAMES=["Admin"]
